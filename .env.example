# OnboardOS -- repository-level environment template (backend + operator tooling).
#
# NOTE: the React app does NOT read this file. Vite loads env files from
# apps/web/. Frontend (VITE_*) configuration lives in apps/web/.env.example.
#
# This file is documentation: nothing in the build, test, or deploy pipeline
# loads a root .env automatically. .env is gitignored. NEVER commit real
# credentials. AWS credentials come from the authorized role/environment
# (e.g. Workshop Studio temporary credentials exported in your shell), never
# from files in this repository.

# -- Backend Lambda environment ------------------------------------------------
# Set by infrastructure/template.yaml (not by a .env file). Listed for reference.
AWS_REGION=us-east-1
ONBOARDOS_CORE_TABLE=<stack-name>-core            # output: CoreTableName
ONBOARDOS_EVENTS_TABLE=<stack-name>-events        # output: EventsTableName
ONBOARDOS_ORG_ID=northstar-cloud                  # template parameter: DemoOrgId

# -- Operator provisioning script (scripts/seed-demo.ts) -----------------------
# Read only when an operator explicitly runs the script. Contains NO passwords:
# passwords are entered at a hidden interactive prompt and never stored.
STACK_NAME=onboardos-dev
ADMIN_EMAIL=admin@northstar-demo.example
MANAGER_EMAIL=manager@northstar-demo.example
EMPLOYEE_EMAIL=employee@northstar-demo.example

# -- Later phases (not deployed yet) -------------------------------------------
ONBOARDOS_TEST_RUNNER_ARN=<deployed-arn>
ONBOARDOS_EVIDENCE_BUCKET=<private-bucket-name>
BEDROCK_MODEL_ID=<organizer-approved-model-id-or-inference-profile>
