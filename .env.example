# Non-secret client-side configuration only
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com
VITE_COGNITO_USER_POOL_ID=<public-user-pool-id>
VITE_COGNITO_CLIENT_ID=<public-spa-client-id>
VITE_AWS_REGION=us-east-1

# Backend-only example configuration; never include AWS secrets in VITE_* values
AWS_REGION=us-east-1
ONBOARDOS_CORE_TABLE=OnboardOSCore
ONBOARDOS_EVENTS_TABLE=OnboardOSEvents
ONBOARDOS_EVIDENCE_BUCKET=<private-bucket-name>
ONBOARDOS_TEST_RUNNER_ARN=<deployed-arn>
BEDROCK_MODEL_ID=<organizer-approved-model-id-or-inference-profile>
# Credentials come from authorized AWS role/environment, never checked-in files.
