# OnboardOS web app -- PUBLIC configuration only.
#
# Setup:   cp apps/web/.env.example apps/web/.env.local
#          (then fill in the values from the CloudFormation stack outputs)
#
# Vite reads env files from THIS directory (apps/web/), not the repository root,
# including when run through npm workspaces. A root-level .env is ignored by the
# web app. Restart `npm --workspace=apps/web run dev` after editing.
#
# Everything here is embedded in the browser bundle. NEVER put passwords, AWS
# keys, session tokens, or client secrets in this file. apps/web/.env.local is
# gitignored; do not commit it.
#
# Get the values with:
#   aws cloudformation describe-stacks --stack-name <STACK_NAME> \
#     --query "Stacks[0].Outputs" --output table

# Output: ApiUrl
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Output: UserPoolClientId   (public SPA client, no secret)
VITE_COGNITO_CLIENT_ID=<spa-client-id>

# Output: CognitoHostedUiDomain  (full host, e.g. <prefix>.auth.<region>.amazoncognito.com)
VITE_COGNITO_DOMAIN=<prefix>.auth.<region>.amazoncognito.com

# Optional / informational
VITE_COGNITO_USER_POOL_ID=<region>_<pool-id>
VITE_AWS_REGION=us-east-1

# Optional: show the AI coworker panel. Leave unset (or false) until the API stack has the /messages routes deployed
# AND the stack parameter CoworkerModelId is set; otherwise the panel would call routes that do not exist yet.
# Read at BUILD time (a frontend redeploy is needed after changing it). Not a security control.
VITE_COWORKER_ENABLED=false
