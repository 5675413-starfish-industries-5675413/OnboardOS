{
  "name": "onboardos-aws-hack-2026",
  "version": "0.1.0",
  "private": true,
  "description": "OnboardOS — AWS × A10 hackathon monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "build": "sam build --template-file infrastructure/template.yaml",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
