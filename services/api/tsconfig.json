{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "paths": {
      "@onboardos/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@onboardos/scenario-engine": [
        "../../packages/scenario-engine/src/index.ts"
      ],
      "@onboardos/scenario-fixtures": [
        "../../packages/scenario-fixtures/src/index.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/scenario-engine"
    },
    {
      "path": "../../packages/scenario-fixtures"
    }
  ],
  "include": [
    "src/**/*"
  ]
}
